<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:PgCopy.Desktop.ViewModels"
  x:Class="PgCopy.Desktop.Views.SnapshotsView"
  x:DataType="vm:SnapshotsViewModel"
>
  <StackPanel Margin="16" Spacing="12" MaxWidth="900" HorizontalAlignment="Left">
    <TextBlock Classes="h2" FontSize="18" Text="Local snapshots" />
    <TextBlock
      TextWrapping="Wrap"
      Opacity="0.75"
      Text="A snapshot is an instant server-side copy of a cloned database. Reset your development database to its freshly cloned state in seconds instead of downloading it again. Uses the target selected on the Clone tab."
    />
    <Border Classes="card">
      <StackPanel>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBlock Text="{Binding Message}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" />
        </Grid>
        <TextBlock
          Text="{Binding ErrorMessage}"
          Foreground="#D13438"
          TextWrapping="Wrap"
          Margin="0,6,0,0"
          IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
        />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="h2" Text="Save a snapshot" />
        <Grid ColumnDefinitions="*,200,Auto" ColumnSpacing="8">
          <ComboBox
            ItemsSource="{Binding LocalDatabases}"
            SelectedItem="{Binding SelectedDatabase}"
            PlaceholderText="Database"
            HorizontalAlignment="Stretch"
          />
          <TextBox Grid.Column="1" Text="{Binding SnapshotName}" PlaceholderText="Snapshot name" />
          <Button Grid.Column="2" Content="Save" Command="{Binding SaveCommand}" Margin="0,0,0,6" />
        </Grid>
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="h2" Text="Existing snapshots" />
        <ListBox
          ItemsSource="{Binding Snapshots}"
          SelectedItem="{Binding SelectedSnapshot}"
          MinHeight="120"
          MaxHeight="260"
        >
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SnapshotRow">
              <Grid ColumnDefinitions="*,100">
                <TextBlock Text="{Binding Title}" />
                <TextBlock
                  Grid.Column="1"
                  Text="{Binding Size}"
                  HorizontalAlignment="Right"
                  Opacity="0.7"
                />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
          <Button Content="Reset database to this snapshot" Command="{Binding RestoreCommand}" />
          <Button Content="Delete" Command="{Binding DeleteCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
